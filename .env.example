# Server-only values. Never use NEXT_PUBLIC_ for these.
CADON_DEMO_ACCESS_CODE=
# Use a random secret at least 32 characters long.
CADON_DEMO_SESSION_SECRET=
# HTTPS endpoint accepting JSON and returning 2xx only after receipt.
CADON_ACCESS_WEBHOOK_URL=
CADON_ACCESS_WEBHOOK_TOKEN=
# Recommended on Vercel for rate limits shared across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connected CADON MCP service. Default is the verified current demo endpoint.
CADON_MCP_URL=https://cadon-demo.fly.dev/mcp
# Optional: only if the MCP service requires server-to-server authentication.
CADON_MCP_TOKEN=
